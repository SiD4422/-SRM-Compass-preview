---
export interface Props {
  size?: number | string;
  class?: string;
  role?: string;
  ariaLabel?: string;
}

const {
  size = 28,
  class: className = '',
  role = 'img',
  ariaLabel
} = Astro.props;

const isHidden = !ariaLabel;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={`brand-compass-svg ${className}`}
  role={role}
  aria-label={ariaLabel}
  aria-hidden={isHidden ? 'true' : undefined}
  focusable="false"
>
  <!-- Outer Precision Dial -->
  <circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="1.75" class="compass-ring-outer" />
  <circle cx="32" cy="32" r="26.5" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="1.5 2.5" class="compass-ring-inner" />
  
  <!-- Cardinal Tick Marks -->
  <line x1="32" y1="2" x2="32" y2="6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <line x1="32" y1="57.5" x2="32" y2="62" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <line x1="2" y1="32" x2="6.5" y2="32" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <line x1="57.5" y1="32" x2="62" y2="32" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

  <!-- Diagonal Sub-Cardinal Points (Subtle) -->
  <path d="M32 32 L46 18 L32 28 Z" fill="currentColor" opacity="0.25" />
  <path d="M32 32 L46 46 L32 36 Z" fill="currentColor" opacity="0.2" />
  <path d="M32 32 L18 46 L32 36 Z" fill="currentColor" opacity="0.2" />
  <path d="M32 32 L18 18 L32 28 Z" fill="currentColor" opacity="0.25" />

  <!-- South Needle (Muted Primary) -->
  <path d="M32 54 L32 32 L26 32 Z" fill="currentColor" opacity="0.6" />
  <path d="M32 54 L38 32 L32 32 Z" fill="currentColor" opacity="0.4" />

  <!-- East Needle -->
  <path d="M54 32 L32 32 L32 26 Z" fill="currentColor" opacity="0.55" />
  <path d="M54 32 L32 38 L32 32 Z" fill="currentColor" opacity="0.35" />

  <!-- West Needle -->
  <path d="M10 32 L32 26 L32 32 Z" fill="currentColor" opacity="0.55" />
  <path d="M10 32 L32 32 L32 38 Z" fill="currentColor" opacity="0.35" />

  <!-- North Needle (Gold / High Contrast Cardinal) -->
  <path d="M32 10 L32 32 L26 32 Z" fill="#E4B316" class="compass-north-light" />
  <path d="M32 10 L38 32 L32 32 Z" fill="#C99700" class="compass-north-dark" />

  <!-- Center Pivot Hub -->
  <circle cx="32" cy="32" r="5" fill="var(--surface, #ffffff)" stroke="currentColor" stroke-width="1.5" />
  <circle cx="32" cy="32" r="2.2" fill="#E4B316" />
</svg>
