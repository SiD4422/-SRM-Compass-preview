---
import '../styles/tokens.css';
import BrandCompass from '../components/BrandCompass.astro';
import { t } from '../lib/i18n';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = t('layout.default_title'),
  description = t('layout.default_description'),
  canonical
} = Astro.props;

// Determine active pathname cleanly
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = canonical || (Astro.site ? new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site).href : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='30' fill='%230B2A4A' stroke='%23E4B316' stroke-width='2'/%3E%3Cpath d='M32 10 L38 32 L32 32 Z' fill='%23E4B316'/%3E%3Cpath d='M32 10 L26 32 L32 32 Z' fill='%23FFF'/%3E%3Cpath d='M32 54 L38 32 L32 32 Z' fill='%237C95B1'/%3E%3Cpath d='M32 54 L26 32 L32 32 Z' fill='%234A6585'/%3E%3Ccircle cx='32' cy='32' r='4.5' fill='%230B2A4A' stroke='%23E4B316' stroke-width='1.5'/%3E%3Ccircle cx='32' cy='32' r='2' fill='%23E4B316'/%3E%3C/svg%3E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main-content">{t('layout.skip_to_content')}</a>

    <header class="top">
      <div class="w header-bar">
        <a class="brand" href="/">
          <BrandCompass size={26} class="brand-compass-icon" />
          <span>{t('layout.brand_name')}</span>
        </a>
        <nav class="nav-desktop" aria-label={t('layout.nav.main_aria')}>
          <a
            href="/programmes"
            aria-current={pathname === '/programmes' ? 'page' : undefined}
          >
            {t('layout.nav.programmes')}
          </a>
          <a
            href="/compare"
            aria-current={pathname === '/compare' ? 'page' : undefined}
          >
            {t('layout.nav.compare')}
          </a>
          <a
            href="/eligibility"
            aria-current={pathname === '/eligibility' ? 'page' : undefined}
          >
            {t('layout.nav.eligibility')}
          </a>
          <a
            href="/stories"
            aria-current={pathname.startsWith('/stories') ? 'page' : undefined}
          >
            {t('layout.nav.stories')}
          </a>
          <a
            href="/apply"
            aria-current={pathname === '/apply' ? 'page' : undefined}
          >
            {t('layout.nav.apply')}
          </a>
        </nav>

        <details class="mobile-nav-details" id="mobile-menu-details">
          <summary class="mobile-nav-btn" aria-label={t('layout.nav.menu_btn_aria')} role="button">
            <span class="menu-text">{t('layout.nav.menu_btn_text')}</span>
            <span class="menu-icon" aria-hidden="true">☰</span>
          </summary>
          <nav class="mobile-nav-panel" aria-label={t('layout.nav.mobile_aria')}>
            <a
              href="/programmes"
              aria-current={pathname === '/programmes' ? 'page' : undefined}
            >
              {t('layout.nav.programmes')}
            </a>
            <a
              href="/compare"
              aria-current={pathname === '/compare' ? 'page' : undefined}
            >
              {t('layout.nav.compare')}
            </a>
            <a
              href="/eligibility"
              aria-current={pathname === '/eligibility' ? 'page' : undefined}
            >
              {t('layout.nav.eligibility')}
            </a>
            <a
              href="/stories"
              aria-current={pathname.startsWith('/stories') ? 'page' : undefined}
            >
              {t('layout.nav.stories')}
            </a>
            <a
              href="/apply"
              aria-current={pathname === '/apply' ? 'page' : undefined}
            >
              {t('layout.nav.apply')}
            </a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <div class="w">
        <p>
          {t('layout.footer.disclaimer')}
        </p>
        <nav class="footer-links" aria-label={t('layout.footer.links_aria')}>
          <a href="/evidence">{t('layout.footer.evidence_link')}</a>
          <span class="footer-sep" aria-hidden="true">&bull;</span>
          <a href="/stories">{t('layout.footer.stories_link')}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
