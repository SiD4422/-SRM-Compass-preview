---
import '../styles/tokens.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'SRM Compass: find your SRM programme',
  description = 'Find the SRM programme that fits you. Fees, seats and departments from SRM’s official table, each linked to its source.',
  canonical
} = Astro.props;

// Determine active pathname cleanly
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = canonical || (Astro.site ? new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site).href : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main-content">Skip to content</a>

    <header class="top">
      <div class="w header-bar">
        <a class="brand" href="/">
          <i>✦</i>SRM Compass
        </a>
        <nav class="nav-desktop" aria-label="Main">
          <a
            href="/programmes"
            aria-current={pathname === '/programmes' ? 'page' : undefined}
          >
            Programmes
          </a>
          <a
            href="/compare"
            aria-current={pathname === '/compare' ? 'page' : undefined}
          >
            Compare
          </a>
          <a
            href="/eligibility"
            aria-current={pathname === '/eligibility' ? 'page' : undefined}
          >
            Eligibility
          </a>
          <a
            href="/stories"
            aria-current={pathname.startsWith('/stories') ? 'page' : undefined}
          >
            Stories
          </a>
          <a
            href="/apply"
            aria-current={pathname === '/apply' ? 'page' : undefined}
          >
            Apply
          </a>
        </nav>

        <details class="mobile-nav-details" id="mobile-menu-details">
          <summary class="mobile-nav-btn" aria-label="Menu" role="button">
            <span class="menu-text">Menu</span>
            <span class="menu-icon" aria-hidden="true">☰</span>
          </summary>
          <nav class="mobile-nav-panel" aria-label="Mobile Navigation">
            <a
              href="/programmes"
              aria-current={pathname === '/programmes' ? 'page' : undefined}
            >
              Programmes
            </a>
            <a
              href="/compare"
              aria-current={pathname === '/compare' ? 'page' : undefined}
            >
              Compare
            </a>
            <a
              href="/eligibility"
              aria-current={pathname === '/eligibility' ? 'page' : undefined}
            >
              Eligibility
            </a>
            <a
              href="/stories"
              aria-current={pathname.startsWith('/stories') ? 'page' : undefined}
            >
              Stories
            </a>
            <a
              href="/apply"
              aria-current={pathname === '/apply' ? 'page' : undefined}
            >
              Apply
            </a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <div class="w">
        <p>
          Independent design entry for the SRM Next-Gen Website Design Challenge 2026 for the 2026-27 cycle; SRM may revise for 2027 entry. Not an official SRM site. Check each source link before relying on a number.
        </p>
        <nav class="footer-links" aria-label="Footer links">
          <a href="/evidence">Sources &amp; verification methodology</a>
          <span class="footer-sep" aria-hidden="true">&bull;</span>
          <a href="/stories">Built at SRM stories</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
