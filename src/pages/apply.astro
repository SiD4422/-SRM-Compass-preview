---
import Layout from '../layouts/Layout.astro';
import applyRoutesData from '../../data/apply_routes.json';
import { t } from '../lib/i18n';

interface RouteItem {
  id: string;
  label: string;
  exam: string;
  steps: string;
  link: string;
}

const applyData = applyRoutesData as {
  note: string;
  source: {
    id: string;
    title: string;
    url: string;
    captured_on: string;
  };
  portal: string;
  helpline: string;
  helpline_hours: string;
  email: string;
  routes: RouteItem[];
};
---

<Layout
  title={t('apply.meta.title')}
  description={t('apply.meta.description')}
>
  <div class="w page-container">
    <nav class="breadcrumb" aria-label={t('apply.breadcrumb.aria')}>
      <a href="/">{t('apply.breadcrumb.home')}</a>
      <span aria-hidden="true">&rsaquo;</span>
      <span aria-current="page">{t('apply.breadcrumb.apply')}</span>
    </nav>

    <header class="apply-header">
      <div class="eyebrow">{t('apply.eyebrow')}</div>
      <h1>{t('apply.heading')}</h1>
      <p class="lead" set:html={t('apply.lead')}></p>
    </header>

    <!-- 1. B.Tech Three-Step Overview -->
    <section class="steps-section">
      <h2>{t('apply.steps.heading')}</h2>
      <p class="section-desc" set:html={t('apply.steps.description')}></p>
      
      <ol class="st-cards">
        <li class="st-card">
          <div class="st-number">1</div>
          <div class="st-body">
            <h3>{t('apply.steps.step1_title')}</h3>
            <p>
              {t('apply.steps.step1_text')}
            </p>
            <a href="/eligibility#check" class="st-link">{t('apply.steps.step1_link')}</a>
          </div>
        </li>

        <li class="st-card">
          <div class="st-number">2</div>
          <div class="st-body">
            <h3>{t('apply.steps.step2_title')}</h3>
            <p>
              {t('apply.steps.step2_text')}
            </p>
            <a
              href="https://applications.srmist.edu.in/btech"
              target="_blank"
              rel="noopener noreferrer"
              class="st-link"
            >
              {t('apply.steps.step2_link')}
            </a>
          </div>
        </li>

        <li class="st-card">
          <div class="st-number">3</div>
          <div class="st-body">
            <h3>{t('apply.steps.step3_title')}</h3>
            <p>
              {t('apply.steps.step3_text')}
            </p>
            <a href="/programmes" class="st-link">{t('apply.steps.step3_link')}</a>
          </div>
        </li>
      </ol>
    </section>

    <!-- 2. Which route fits you? (Progressive Enhancement) -->
    <section class="routes-section" id="routes">
      <div class="routes-header">
        <h2>{t('apply.routes.heading')}</h2>
        <p class="routes-intro">
          {t('apply.routes.intro')}
        </p>
      </div>

      <!-- Interactive Switcher (Client JS enabled) -->
      <div class="route-switcher-wrap" id="route-switcher-container">
        <label for="route-select" class="route-select-label">
          <strong>{t('apply.routes.select_label')}</strong>
        </label>
        <select id="route-select" class="ctrl-select">
          {applyData.routes.map((route, idx) => (
            <option value={route.id} selected={idx === 0}>
              {route.label}
            </option>
          ))}
        </select>
      </div>

      <!-- Route Cards Container: details elements rendered for no-JS fallback -->
      <div class="routes-cards-list" id="routes-list">
        {applyData.routes.map((route, idx) => (
          <details
            class="route-details-item"
            id={`route-card-${route.id}`}
            open={idx === 0}
          >
            <summary class="route-summary">
              <span class="route-summary-title">{route.label}</span>
              <span class="route-summary-exam">{t('apply.routes.exam_badge', { exam: route.exam })}</span>
            </summary>

            <div class="route-card-content">
              <div class="route-grid">
                <div class="route-info-col">
                  <div class="route-field">
                    <span class="field-label">{t('apply.routes.field_discipline')}</span>
                    <p class="field-value">{route.label}</p>
                  </div>

                  <div class="route-field">
                    <span class="field-label">{t('apply.routes.field_exam')}</span>
                    <p class="field-value exam-highlight">{route.exam}</p>
                  </div>

                  <div class="route-field">
                    <span class="field-label">{t('apply.routes.field_procedure')}</span>
                    <p class="field-value">{route.steps}</p>
                  </div>
                </div>

                <div class="route-contact-col">
                  <div class="contact-box">
                    <h3>{t('apply.routes.support_heading')}</h3>
                    
                    <a
                      href={route.link}
                      class="btn p btn-apply-portal"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {t('apply.routes.apply_btn')}
                    </a>

                    <div class="support-item">
                      <span class="support-label">{t('apply.routes.helpline_label')}</span>
                      <a href={`tel:${applyData.helpline.replace(/\s+/g, '')}`} class="support-val">
                        {applyData.helpline}
                      </a>
                      <span class="support-hours">{applyData.helpline_hours}</span>
                    </div>

                    <div class="support-item">
                      <span class="support-label">{t('apply.routes.email_label')}</span>
                      <a href={`mailto:${applyData.email}`} class="support-val">
                        {applyData.email}
                      </a>
                    </div>

                    <div class="support-source-stamp">
                      <span>{t('apply.routes.source_prefix', { id: applyData.source.id })}</span>
                      <a href={applyData.source.url} target="_blank" rel="noopener noreferrer">
                        {applyData.source.title}
                      </a>
                      <span class="stamp-date">{t('apply.routes.captured_date', { date: applyData.source.captured_on })}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>

      <!-- No-JS Explanatory note -->
      <noscript>
        <p class="noscript-note">
          {t('apply.routes.noscript_note')}
        </p>
      </noscript>
    </section>

    <!-- Bottom Actions -->
    <div class="apply-bottom-actions">
      <a class="btn p" href="/programmes">{t('apply.actions.browse_options')}</a>
      <a class="btn s" href="/eligibility#check">{t('apply.actions.test_eligibility')}</a>
      <a class="btn s" href="/stories">{t('apply.actions.student_stories')}</a>
    </div>
  </div>
</Layout>

<script>
  // Progressive enhancement for route switcher
  const selectElem = document.getElementById('route-select') as HTMLSelectElement | null;
  const routeItems = document.querySelectorAll<HTMLDetailsElement>('.route-details-item');

  if (selectElem && routeItems.length > 0) {
    function updateActiveRoute(activeId: string) {
      routeItems.forEach((item) => {
        const isMatch = item.id === `route-card-${activeId}`;
        item.open = isMatch;
        if (isMatch) {
          item.classList.add('is-active-route');
          // Ensure smooth focus without jarring scroll
          item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          item.classList.remove('is-active-route');
        }
      });
    }

    selectElem.addEventListener('change', () => {
      updateActiveRoute(selectElem.value);
    });

    // Also synchronize if user clicks any details summary directly
    routeItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open) {
          const id = item.id.replace('route-card-', '');
          if (selectElem.value !== id) {
            selectElem.value = id;
          }
          // Close others for clean single-route view when JS is active
          routeItems.forEach((other) => {
            if (other !== item) other.open = false;
          });
        }
      });
    });
  }
</script>

<style>
  .page-container {
    padding-top: 28px;
    padding-bottom: 60px;
  }
  .breadcrumb {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breadcrumb a {
    color: var(--link);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .apply-header {
    margin-bottom: 32px;
  }
  .eyebrow {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--navy);
    margin-bottom: 6px;
  }
  .apply-header h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 10px 0;
    line-height: 1.15;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 720px;
    margin: 0;
  }

  /* Three-step visual cards */
  .steps-section {
    margin-bottom: 48px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 28px 24px;
  }
  .steps-section h2 {
    font-size: 1.5rem;
    margin: 0 0 8px 0;
  }
  .section-desc {
    color: var(--muted);
    margin: 0 0 24px 0;
    font-size: 0.98rem;
    max-width: 800px;
  }
  .st-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .st-card {
    background: var(--surface-alt);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .st-number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 14px;
  }
  .st-body h3 {
    font-size: 1.1rem;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }
  .st-body p {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 16px 0;
  }
  .st-link {
    display: inline-block;
    margin-top: auto;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--link);
    text-decoration: none;
  }
  .st-link:hover {
    text-decoration: underline;
  }

  /* Routes Section */
  .routes-section {
    margin-bottom: 48px;
  }
  .routes-header {
    margin-bottom: 20px;
  }
  .routes-header h2 {
    font-size: 1.6rem;
    margin: 0 0 8px 0;
  }
  .routes-intro {
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
    max-width: 800px;
  }

  .route-switcher-wrap {
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 16px 20px;
    border-radius: 8px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .route-select-label {
    font-size: 0.95rem;
    color: var(--ink);
  }
  .ctrl-select {
    font-size: 1rem;
    padding: 10px 14px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    max-width: 100%;
    cursor: pointer;
  }

  /* Route Details & Cards */
  .routes-cards-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .route-details-item {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .route-details-item[open] {
    border-color: var(--navy);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .route-summary {
    padding: 16px 20px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: var(--surface-alt);
    border-bottom: 1px solid transparent;
    user-select: none;
  }
  .route-details-item[open] .route-summary {
    border-bottom-color: var(--rule);
  }
  .route-summary-title {
    font-size: 1.05rem;
    color: var(--ink);
  }
  .route-summary-exam {
    font-size: 0.85rem;
    background: rgba(12, 77, 162, 0.1);
    color: var(--navy);
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  .route-card-content {
    padding: 24px 20px;
  }
  .route-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 28px;
  }
  .route-info-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .route-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .field-label {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 700;
  }
  .field-value {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .exam-highlight {
    font-weight: 700;
    color: var(--navy);
    font-size: 1.15rem;
  }

  .route-contact-col {
    display: flex;
    flex-direction: column;
  }
  .contact-box {
    background: var(--surface-alt);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact-box h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .btn-apply-portal {
    display: inline-flex;
    justify-content: center;
    text-align: center;
    padding: 10px 16px;
    font-size: 0.95rem;
  }
  .support-item {
    display: flex;
    flex-direction: column;
    font-size: 0.88rem;
    gap: 2px;
  }
  .support-label {
    color: var(--muted);
    font-weight: 600;
  }
  .support-val {
    color: var(--link);
    text-decoration: none;
    font-weight: 600;
  }
  .support-val:hover {
    text-decoration: underline;
  }
  .support-hours {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .support-source-stamp {
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px dashed var(--rule);
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .support-source-stamp a {
    color: var(--link);
    text-decoration: none;
  }
  .support-source-stamp a:hover {
    text-decoration: underline;
  }

  .noscript-note {
    font-size: 0.88rem;
    color: var(--muted);
    margin-top: 12px;
    font-style: italic;
  }

  /* Bottom Actions */
  .apply-bottom-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 840px) {
    .st-cards {
      grid-template-columns: 1fr;
    }
    .route-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
