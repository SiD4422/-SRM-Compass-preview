---
import Layout from '../layouts/Layout.astro';
import offeringsData from '../../data/offerings.json';
import { t } from '../lib/i18n';

const totalOfferings = offeringsData.length;
const conflictCount = offeringsData.filter(
  (o) => o.eligibility?.status === 'conflict'
).length;

const linkHtml = `<a href="https://www.srmist.edu.in/admission-india/engineering/" rel="noopener" target="_blank">the same SRM page</a>`;
const methodHtml = `<code>method="post"</code>`;
---

<Layout
  title={t('eligibility.meta.title')}
  description={t('eligibility.meta.description')}
>
  <section class="blk">
    <div class="w">
      <h1>{t('eligibility.heading')}</h1>
      <p class="lede">
        {t('eligibility.lede')}
      </p>

      <!-- Interactive Eligibility Checker Tool (id 'check') -->
      <section id="check" class="checker-card" aria-labelledby="checker-title">
        <div class="checker-intro">
          <h2 id="checker-title">{t('eligibility.checker.title')}</h2>
          <p class="checker-desc">
            {t('eligibility.checker.description')}
          </p>
          <div class="privacy-note" role="note">
            <span class="privacy-icon" aria-hidden="true">🔒</span>
            <span>
              <strong>{t('eligibility.checker.privacy_label')}</strong> {t('eligibility.checker.privacy_text')}
            </span>
          </div>
        </div>

        <noscript>
          <div class="noscript-banner" role="alert">
            <strong>{t('eligibility.checker.noscript_title')}</strong>
            <span set:html={t('eligibility.checker.noscript_text', { method: methodHtml })}></span>
          </div>
        </noscript>

        <form id="eligibility-form" class="checker-form" action="#check" method="post" novalidate>
          <!-- 1. Resident Indian (yes/no) -->
          <div class="form-row">
            <fieldset class="ctrl-fieldset">
              <legend class="ctrl-label">{t('eligibility.form.resident_legend')} <span class="req" aria-hidden="true">*</span></legend>
              <div class="radio-options">
                <label class="radio-label">
                  <input type="radio" name="resident" value="yes" checked />
                  <span>{t('eligibility.form.resident_yes')}</span>
                </label>
                <label class="radio-label">
                  <input type="radio" name="resident" value="no" />
                  <span>{t('eligibility.form.resident_no')}</span>
                </label>
              </div>
            </fieldset>
          </div>

          <!-- 2. Qualifying Board & Class 12 Status -->
          <div class="form-grid-2">
            <div class="ctrl-group">
              <label for="board-select" class="ctrl-label">{t('eligibility.form.board_label')} <span class="req" aria-hidden="true">*</span></label>
              <select id="board-select" name="board" class="ctrl-select" required>
                <option value="CBSE">{t('eligibility.form.board_cbse')}</option>
                <option value="ISCE">{t('eligibility.form.board_isce')}</option>
                <option value="State board">{t('eligibility.form.board_state')}</option>
                <option value="NIOS">{t('eligibility.form.board_nios')}</option>
                <option value="IB">{t('eligibility.form.board_ib')}</option>
                <option value="GCE A-level">{t('eligibility.form.board_gce')}</option>
              </select>
            </div>

            <div class="ctrl-group">
              <label for="status-select" class="ctrl-label">{t('eligibility.form.status_label')} <span class="req" aria-hidden="true">*</span></label>
              <select id="status-select" name="status" class="ctrl-select" required>
                <option value="passed">{t('eligibility.form.status_passed')}</option>
                <option value="appearing">{t('eligibility.form.status_appearing')}</option>
              </select>
            </div>
          </div>

          <!-- 3. Class 12 Exam Year & Date of Birth -->
          <div class="form-grid-2">
            <div class="ctrl-group">
              <label for="exam-year" class="ctrl-label">{t('eligibility.form.exam_year_label')} <span class="req" aria-hidden="true">*</span></label>
              <select id="exam-year" name="examYear" class="ctrl-select" required>
                <option value="2026" selected>2026</option>
                <option value="2027">2027</option>
              </select>
              <span class="field-hint">{t('eligibility.form.exam_year_hint')}</span>
            </div>

            <div class="ctrl-group">
              <label for="dob" class="ctrl-label">{t('eligibility.form.dob_label')} <span class="req" aria-hidden="true">*</span></label>
              <input
                type="date"
                id="dob"
                name="dob"
                class="ctrl-input"
                required
              />
              <span id="dob-error" class="field-error-msg" hidden></span>
              <span class="field-hint">{t('eligibility.form.dob_hint')}</span>
            </div>
          </div>

          <!-- 4. Programme Group -->
          <div class="ctrl-group">
            <label for="group-select" class="ctrl-label">{t('eligibility.form.group_label')} <span class="req" aria-hidden="true">*</span></label>
            <select id="group-select" name="programmeGroup" class="ctrl-select" required>
              <option value="general">{t('eligibility.form.group_general')}</option>
              <option value="biotech">{t('eligibility.form.group_biotech')}</option>
            </select>
          </div>

          <!-- 5. Subjects behind Aggregate -->
          <!-- For General Group -->
          <div id="general-subjects-row" class="subjects-card">
            <span class="ctrl-label">{t('eligibility.form.general_subjects_title')}</span>
            <p class="subjects-desc">
              {t('eligibility.form.general_subjects_desc')}
            </p>
            <div class="subject-checkboxes">
              <label class="subject-checkbox-label">
                <input type="checkbox" id="has-physics" name="hasPhysics" checked />
                <span>{t('eligibility.form.physics_mandatory')}</span>
              </label>
              <label class="subject-checkbox-label">
                <input type="checkbox" id="has-math" name="hasMath" checked />
                <span>{t('eligibility.form.math_mandatory')}</span>
              </label>
            </div>
            <div class="ctrl-group" style="margin-top: 14px;">
              <label for="third-subject" class="ctrl-label">{t('eligibility.form.third_subject_label')}</label>
              <select id="third-subject" name="thirdSubject" class="ctrl-select">
                <option value="Chemistry">{t('eligibility.form.subj_chemistry')}</option>
                <option value="Computer Science">{t('eligibility.form.subj_cs')}</option>
                <option value="Information Technology">{t('eligibility.form.subj_it')}</option>
                <option value="Informatics Practices">{t('eligibility.form.subj_ip')}</option>
                <option value="Biology">{t('eligibility.form.subj_biology')}</option>
                <option value="Biotechnology">{t('eligibility.form.subj_biotech')}</option>
                <option value="Engineering Graphics">{t('eligibility.form.subj_eg')}</option>
                <option value="Botany and Zoology">{t('eligibility.form.subj_botany_zoology')}</option>
              </select>
            </div>
          </div>

          <!-- For Biotech Group -->
          <div id="biotech-subjects-row" class="subjects-card" hidden>
            <label for="biotech-combo" class="ctrl-label">{t('eligibility.form.biotech_combo_label')} <span class="req" aria-hidden="true">*</span></label>
            <select id="biotech-combo" name="biotechCombo" class="ctrl-select">
              <option value="PCM">{t('eligibility.form.combo_pcm')}</option>
              <option value="PMB">{t('eligibility.form.combo_pmb')}</option>
              <option value="PCB">{t('eligibility.form.combo_pcb')}</option>
              <option value="Z (Botany or Zoology)">{t('eligibility.form.combo_z')}</option>
            </select>
            <span class="field-hint">{t('eligibility.form.biotech_hint')}</span>
          </div>

          <!-- 6. Aggregate Percentage -->
          <div class="ctrl-group">
            <label for="aggregate" class="ctrl-label">{t('eligibility.form.aggregate_label')} <span class="req" aria-hidden="true">*</span></label>
            <input
              type="number"
              id="aggregate"
              name="aggregate"
              min="0"
              max="100"
              step="any"
              placeholder={t('eligibility.form.aggregate_placeholder')}
              class="ctrl-input"
              required
            />
            <span id="aggregate-error" class="field-error-msg" hidden></span>
            <span class="field-hint">{t('eligibility.form.aggregate_hint')}</span>
          </div>

          <!-- Action buttons -->
          <div class="checker-actions">
            <button type="submit" id="checker-submit-btn" class="btn p" disabled>{t('eligibility.form.submit_btn')}</button>
            <button type="button" id="checker-reset-btn" class="btn s">{t('eligibility.form.reset_btn')}</button>
          </div>
        </form>

        <!-- Result Mount Container -->
        <div id="checker-result" class="checker-result-wrapper" role="region" aria-live="polite" hidden></div>
      </section>

      <!-- Source Conflict Note -->
      <div class="note">
        <p>
          <b>{t('eligibility.conflict.title')}</b> {t('eligibility.conflict.body', { conflictCount, totalOfferings })}
        </p>
        <details>
          <summary>{t('eligibility.conflict.summary')}</summary>
          <p set:html={t('eligibility.conflict.details', { link: linkHtml })}></p>
        </details>
      </div>

      <!-- 2026-2027 Rule Breakdown Card -->
      <div class="card">
        <h2>{t('eligibility.breakdown.heading')}</h2>
        <p class="capture-note" style="margin-top: -6px; margin-bottom: 16px; font-size: 0.88rem; color: var(--muted);">{t('eligibility.rules.capture_note')}</p>
        <ol class="st">
          <li>
            <strong>{t('eligibility.breakdown.rule1_label')}</strong> {t('eligibility.rules.general')}
          </li>
          <li>
            <strong>{t('eligibility.breakdown.rule2_label')}</strong> {t('eligibility.rules.biotech')}
          </li>
          <li>
            <strong>{t('eligibility.breakdown.rule3_label')}</strong> {t('eligibility.breakdown.rule3_text')}
          </li>
          <li>
            <strong>{t('eligibility.breakdown.rule4_label')}</strong> {t('eligibility.breakdown.rule4_text')}
          </li>
        </ol>
      </div>

      <div class="btn-row">
        <a class="btn p" href="/programmes">{t('eligibility.actions.programmes')}</a>
        <a class="btn s" href="/apply">{t('eligibility.actions.apply')}</a>
      </div>
    </div>
  </section>

  <!-- Client runner importing all logic from src/lib/eligibility -->
  <script>
    import { initEligibilityChecker } from '../lib/eligibility';
    initEligibilityChecker();
  </script>
</Layout>

<style>
  .checker-card {
    background: var(--surface);
    border: 2px solid var(--rule);
    border-radius: 8px;
    padding: 32px 24px;
    margin: 24px 0 36px 0;
  }

  .checker-intro {
    margin-bottom: 24px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 20px;
  }

  .noscript-banner {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: rgba(180, 83, 9, 0.12);
    border: 1px solid #d97706;
    color: var(--ink);
    border-radius: 6px;
    padding: 14px 18px;
    margin-bottom: 20px;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .checker-intro h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    margin-bottom: 8px;
  }

  .checker-desc {
    color: var(--muted);
    font-size: 1.05rem;
    margin-bottom: 16px;
  }

  .privacy-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: rgba(12, 77, 162, 0.08);
    border: 1px solid rgba(12, 77, 162, 0.25);
    color: var(--ink);
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .privacy-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .checker-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: flex;
    flex-direction: column;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .ctrl-fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .ctrl-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ctrl-label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .req {
    color: var(--danger);
  }

  .radio-options {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 8px;
  }

  .radio-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .ctrl-select,
  .ctrl-input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font-size: 1rem;
  }

  .ctrl-select:focus,
  .ctrl-input:focus {
    outline: none;
    border-color: var(--navy);
    box-shadow: 0 0 0 3px rgba(12, 77, 162, 0.2);
  }

  .input-has-error {
    border-color: var(--danger) !important;
    background: rgba(197, 48, 48, 0.04);
  }

  .field-hint {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.3;
  }

  .field-error-msg {
    font-size: 0.85rem;
    color: var(--danger);
    font-weight: 600;
  }

  .subjects-card {
    background: var(--surface-alt);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 18px 20px;
  }

  .subjects-desc {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 4px 0 14px 0;
  }

  .subject-checkboxes {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .subject-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
    min-height: 44px;
    user-select: none;
  }

  .subject-checkbox-label input[type="checkbox"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
  }

  .checker-actions {
    display: flex;
    gap: 12px;
    margin-top: 10px;
  }

  /* Result Container Styling */
  .checker-result-wrapper {
    margin-top: 28px;
  }

  :global(.result-card) {
    border-radius: 8px;
    padding: 24px;
    border: 2px solid transparent;
  }

  :global(.verdict-meets) {
    background: rgba(22, 101, 52, 0.06);
    border-color: #15803d;
  }

  :global(.verdict-fails) {
    background: rgba(185, 28, 28, 0.06);
    border-color: #b91c1c;
  }

  :global(.verdict-refer) {
    background: rgba(12, 77, 162, 0.06);
    border-color: #0c4da2;
  }

  :global(.verdict-error) {
    background: rgba(180, 83, 9, 0.08);
    border-color: #b45309;
  }

  :global(.result-header) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  :global(.result-badge) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
  }

  :global(.verdict-meets .result-badge) {
    background: #15803d;
  }

  :global(.verdict-fails .result-badge) {
    background: #b91c1c;
  }

  :global(.verdict-refer .result-badge) {
    background: #0c4da2;
  }

  :global(.verdict-error .result-badge) {
    background: #b45309;
  }

  :global(.result-headline) {
    font-size: 1.35rem;
    margin: 0;
  }

  :global(.result-reasons) {
    margin: 0 0 16px 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  :global(.error-intro) {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 10px;
  }

  :global(.error-reasons) {
    color: var(--danger);
  }

  :global(.result-math-note) {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 4px solid #b45309;
    border-radius: 4px;
    padding: 12px 16px;
    margin-bottom: 18px;
    font-size: 0.92rem;
  }

  :global(.result-math-note p) {
    margin: 4px 0 0 0;
  }

  :global(.result-rule) {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 16px 18px;
    margin-bottom: 18px;
  }

  :global(.result-rule h4) {
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0 0 10px 0;
  }

  :global(.rule-quote) {
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0 0 12px 0;
    color: var(--ink);
  }

  :global(.rule-line) {
    font-size: 0.88rem;
    margin: 4px 0;
    color: var(--ink);
  }

  :global(.result-source-row) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--rule);
    font-size: 0.85rem;
  }

  :global(.source-link) {
    color: var(--link);
    text-decoration: none;
    font-weight: 500;
  }

  :global(.source-link:hover) {
    text-decoration: underline;
  }

  :global(.result-disclaimer) {
    font-size: 0.85rem;
    color: var(--muted);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 12px;
    margin-top: 14px;
  }

  :global(.result-disclaimer p) {
    margin: 0;
  }

  :global(.result-privacy) {
    margin-top: 8px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .form-grid-2 {
      grid-template-columns: 1fr;
    }
    .checker-actions {
      flex-direction: column;
    }
    .checker-actions .btn {
      width: 100%;
    }
  }
</style>
