---
import Layout from '../layouts/Layout.astro';
import sourcesData from '../../data/sources.json';
import dataHashes from '../data-hash.json';

interface SourceItem {
  id: string;
  title: string;
  url: string;
  kind?: string;
  captured_on?: string;
  note?: string;
}

const sources = sourcesData as SourceItem[];

function formatDate(dateStr?: string): string {
  if (!dateStr) return '';
  const [year, month, day] = dateStr.split('-');
  if (year && month && day) {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const mIdx = parseInt(month, 10) - 1;
    if (mIdx >= 0 && mIdx < 12) {
      return `${parseInt(day, 10)} ${months[mIdx]} ${year}`;
    }
  }
  return dateStr;
}
---

<Layout
  title="Sources & Evidence — SRM Compass"
  description="Every number and requirement on SRM Compass is cited to its exact primary source."
>
  <section class="blk">
    <div class="w">
      <h1>Sources &amp; Evidence</h1>
      <p class="lede">
        Primary official sources audited and verified for the SRM Compass dataset. Every number, fee, seat count, and rule references one of these sources.
      </p>

      <ul class="src">
        {sources.map((src) => (
          <li id={src.id}>
            <strong>[{src.id}]</strong>{' '}
            <a href={src.url} rel="noopener" target="_blank">
              {src.title}
            </a>
            {src.captured_on && (
              <span style="color: var(--muted); margin-left: 6px;">
                — Captured {formatDate(src.captured_on)}
              </span>
            )}
            {src.kind && (
              <span style="display: block; font-size: 0.9rem; color: var(--muted); margin-top: 4px;">
                Type: <em>{src.kind}</em>
              </span>
            )}
            {src.note && (
              <span style="display: block; font-size: 0.95rem; margin-top: 4px;">
                {src.note}
              </span>
            )}
          </li>
        ))}
      </ul>

      <div class="card" style="margin-top: 36px;">
        <h3>Dataset Integrity &amp; Hashes</h3>
        <p style="font-size: 0.95rem; color: var(--muted); margin-bottom: 12px;">
          Cryptographic SHA-256 hashes verifying that underlying JSON datasets have not been altered without audit trail:
        </p>
        <ul style="list-style: none; padding: 0; font-family: monospace; font-size: 0.85rem; display: flex; flex-direction: column; gap: 8px;">
          <li>
            <strong>data/offerings.m1.json:</strong><br />
            <code>{dataHashes['offerings.m1.json'].sha256}</code>
          </li>
          <li>
            <strong>data/sources.json:</strong><br />
            <code>{dataHashes['sources.json'].sha256}</code>
          </li>
        </ul>
      </div>

      <div class="btn-row" style="margin-top: 36px;">
        <a class="btn p" href="/#programmes">Back to programmes</a>
        <a class="btn s" href="/eligibility">Check eligibility</a>
      </div>
    </div>
  </section>
</Layout>
