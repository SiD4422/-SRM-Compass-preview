---
import Layout from '../layouts/Layout.astro';
import VerifiedFact, { type FactData, type SourceData } from '../components/VerifiedFact.astro';
import offeringsM1Data from '../../data/offerings.m1.json';
import fullOfferingsData from '../../data/offerings.json';
import sourcesData from '../../data/sources.json';
import tagsData from '../../data/tags.json';
import programmesData from '../../data/programmes.json';
import { getAllStories, getStoryField } from '../lib/stories';
import BrandCompass from '../components/BrandCompass.astro';

interface OfferingItem {
  id: string;
  programme: string;
  campus_code: string;
  campus: string;
  degree: string;
  program_type: string;
  annual_fee: FactData;
  intake: FactData;
  duration: FactData;
  department: FactData | null;
  eligibility: FactData;
}

const offerings = offeringsM1Data as OfferingItem[];
const allOfferings = fullOfferingsData as OfferingItem[];
const sources = sourcesData as SourceData[];

// Create sources map for fast lookup
const sourcesMap = sources.reduce<Record<string, SourceData>>((acc, src) => {
  acc[src.id] = src;
  return acc;
}, {});

function formatInr(num: number): string {
  return new Intl.NumberFormat('en-IN').format(num);
}

function formatDate(dateStr?: string): string {
  if (!dateStr) return '';
  const [year, month, day] = dateStr.split('-');
  if (year && month && day) {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const mIdx = parseInt(month, 10) - 1;
    if (mIdx >= 0 && mIdx < 12) {
      return `${parseInt(day, 10)} ${months[mIdx]} ${year}`;
    }
  }
  return dateStr;
}

// 1. Group offerings for example offerings table
const programmeOrder = [
  'Electrical and Electronics Engineering',
  'Computer Science and Engineering',
  'Automobile Engineering',
  'Mechatronics Engineering',
  'Biotechnology'
];

const programmeSlugMap = new Map<string, string>();
for (const prog of (programmesData as { programmes: { slug: string; name: string }[] }).programmes) {
  programmeSlugMap.set(prog.name, prog.slug);
}

const groupedOfferings = programmeOrder.map((progName) => ({
  programme: progName,
  items: offerings.filter((o) => o.programme === progName)
}));

// 2. Compute Campus Row from data (all 6 campuses)
interface CampusSummary {
  code: string;
  name: string;
  optionCount: number;
  minFee: number;
  maxFee: number;
  feeRangeText: string;
  link: string;
}

const campusOrder = ['KTR', 'RMP', 'Trichy', 'VDP', 'NCR', 'BAB'];
const campusDataMap = new Map<string, { name: string; fees: number[]; count: number }>();

for (const off of allOfferings) {
  const code = off.campus_code;
  if (!campusDataMap.has(code)) {
    campusDataMap.set(code, {
      name: off.campus,
      fees: [],
      count: 0
    });
  }
  const entry = campusDataMap.get(code)!;
  entry.count++;
  if (off.annual_fee?.value) {
    entry.fees.push(off.annual_fee.value);
  }
}

const campusCards: CampusSummary[] = Array.from(campusDataMap.entries())
  .map(([code, data]) => {
    const minFee = Math.min(...data.fees);
    const maxFee = Math.max(...data.fees);
    const feeRangeText = minFee === maxFee
      ? `₹${formatInr(minFee)} / yr`
      : `₹${formatInr(minFee)} – ₹${formatInr(maxFee)}`;
    return {
      code,
      name: data.name,
      optionCount: data.count,
      minFee,
      maxFee,
      feeRangeText,
      link: `/programmes?campus=${code}`
    };
  })
  .sort((a, b) => {
    const idxA = campusOrder.indexOf(a.code);
    const idxB = campusOrder.indexOf(b.code);
    return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
  });

// 3. Built at SRM: 3 stories
const featuredStories = getAllStories().slice(0, 3);

// 4. SVG Data Graphics Scale Helpers
function feeToX(fee: number): number {
  return 110 + ((fee - 100000) / 400000) * 330;
}
function countToWidth(count: number): number {
  return (count / 44) * 310;
}
---

<Layout
  title="SRM Compass: find your SRM programme"
  description="Find the SRM programme that fits you. Fees, seats and departments from SRM’s official table, each linked to its source."
>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="w hero-grid-wrapper">
      <div class="hero-main-content">
        <h1>Find the SRM programme that fits you.</h1>
        <p class="lede">
          Fees, seats and departments for B.Tech at six SRMIST campuses, copied from SRM’s official Programs Offered table on 26 Oct 2026 for the 2026-27 cycle; SRM may revise for 2027 entry. All 106 rows link to their source.
        </p>

        <form action="/programmes" method="get" role="search" class="search-form">
          <label for="home-search" class="sr-only">Search programmes, campuses, or departments</label>
          <div class="search-input-wrap">
            <input
              type="search"
              id="home-search"
              name="q"
              placeholder="Search by programme, campus, or keyword (e.g. CSE, AI, KTR)..."
              required
            />
            <button type="submit" class="btn p">Search</button>
          </div>
        </form>

        <div class="quick-tags">
          <span class="quick-tags-label">Explore by field:</span>
          <div class="chips-row">
            {Object.entries(tagsData.labels).map(([tagKey, tagLabel]) => (
              <a class="chip-link" href={`/programmes?tag=${tagKey}`} data-field={tagKey}>
                {tagLabel}
              </a>
            ))}
          </div>
        </div>

        <div class="btn-row">
          <a class="btn p hero-primary" href="/programmes">Browse all 106 options &rarr;</a>
          <a class="btn s" href="/apply">How applying works</a>
          <a class="btn s" href="/eligibility#check">Can I apply?</a>
        </div>
      </div>

      <div class="hero-seal-wrapper">
        <div class="seal" role="img" aria-label="SRM Compass Verification Seal: Checked against SRM's table, 26 Oct 2026">
          <div class="seal-compass-inner">
            <BrandCompass size={46} ariaLabel="" role="presentation" />
          </div>
          <span class="seal-text">Checked against SRM's table,<br />26 Oct 2026</span>
        </div>
        <div class="seal-meta-box">
          <span class="seal-meta-title">106 options, 6 campuses</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. CAN I APPLY? CARD -->
  <section class="blk can-i-apply-section">
    <div class="w">
      <div class="can-i-apply-card">
        <div class="can-i-apply-header">
          <span class="badge-subtle">Instant Checker</span>
          <h2>Can I apply?</h2>
        </div>
        <p class="can-i-apply-desc">
          Check if your Class 12 marks, subjects, and date of birth satisfy SRM’s published minimum criteria for 2026-27 admission. Evaluated instantly in your browser with zero data sent or stored.
        </p>
        <div class="can-i-apply-points">
          <div class="point-item">
            <strong>60% aggregate</strong> in Physics, Mathematics &amp; 1 qualifying subject
          </div>
          <div class="point-item">
            <strong>Age 16y 6m cutoff</strong> on 31 July of examination year
          </div>
          <div class="point-item">
            <strong>Admission via SRMJEEE (UG)</strong>; SRM decides final selection
          </div>
        </div>
        <div class="can-i-apply-action-row">
          <a class="btn p" href="/eligibility#check">Check your eligibility &rarr;</a>
          <a class="btn s" href="/eligibility">View all criteria &amp; source conflicts</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. BUILT AT SRM (3 Stories) -->
  <section class="blk built-at-srm-home">
    <div class="w">
      <div class="section-title-row">
        <div>
          <h2>Built at SRM</h2>
          <p class="section-subtitle">
            Start-ups, engineering teams, and projects created by alumni and students of SRM.
          </p>
        </div>
        <a href="/stories" class="view-all-link">Browse all 7 stories &rarr;</a>
      </div>

      <div class="stories-home-grid">
        {featuredStories.map((story) => (
          <article class="story-home-card" data-field={getStoryField(story.id)}>
            <div class="story-home-top">
              <span class="story-home-kind">{story.kind}</span>
              <span class="story-home-facts-count">{story.facts.length} facts</span>
            </div>
            <h3>
              <a href={`/stories/${story.id}`}>{story.title}</a>
            </h3>
            <p class="story-home-basis">{story.link_basis}</p>
            <p class="story-home-fact-quote">
              &ldquo;{story.facts[0]?.text}&rdquo;
            </p>
            <div class="story-home-footer">
              <a href={`/stories/${story.id}`} class="story-read-link">
                Read story &amp; primary sources &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. CAMPUS ROW (6 Cards computed from data) -->
  <section class="blk campus-row-section">
    <div class="w">
      <div class="section-title-row">
        <div>
          <h2>Six campuses, one entrance form</h2>
          <p class="section-subtitle">
            All 106 B.Tech options across SRMIST’s six campuses with official fee ranges.
          </p>
        </div>
        <a href="/programmes" class="view-all-link">Filter all 106 options &rarr;</a>
      </div>

      <div class="campus-cards-grid">
        {campusCards.map((campus) => (
          <a href={campus.link} class="campus-card">
            <div class="campus-card-header">
              <span class="campus-code-tag">{campus.code}</span>
              <span class="campus-opt-count">{campus.optionCount} option{campus.optionCount > 1 ? 's' : ''}</span>
            </div>
            <h3 class="campus-name">{campus.name}</h3>
            <div class="campus-fee-wrap">
              <span class="campus-fee-label">Annual fee range</span>
              <span class="campus-fee-value">{campus.feeRangeText}</span>
            </div>
            <span class="campus-action-link">View campus options &rarr;</span>
          </a>
        ))}
      </div>

      <!-- Stage C: Pure SVG Campus Data Graphics with Text Table Fallbacks -->
      <div class="campus-graphics-grid">
        <!-- Graphic 1: Fee range by campus -->
        <div class="data-graphic-card">
          <div class="graphic-header">
            <h3>Fee range by campus</h3>
            <p class="graphic-subtitle">Annual B.Tech tuition spectrum from SRM’s official table (₹1.00L to ₹4.75L)</p>
          </div>

          <div class="svg-container">
            <svg
              viewBox="0 0 550 230"
              width="100%"
              class="data-graphic-svg"
              role="img"
              aria-labelledby="fee-chart-title fee-chart-desc"
            >
              <title id="fee-chart-title">Fee range by campus</title>
              <desc id="fee-chart-desc">Horizontal range bars showing the minimum and maximum annual B.Tech fee across all six SRMIST campuses from official data.</desc>

              <!-- Gridlines & Axis labels -->
              <line x1="110" y1="20" x2="110" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="192.5" y1="20" x2="192.5" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="275" y1="20" x2="275" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="357.5" y1="20" x2="357.5" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="440" y1="20" x2="440" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />

              <text x="110" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">₹1L</text>
              <text x="192.5" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">₹2L</text>
              <text x="275" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">₹3L</text>
              <text x="357.5" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">₹4L</text>
              <text x="440" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">₹5L</text>

              <!-- Campus Range Bars -->
              {campusCards.map((c, i) => {
                const y = 32 + i * 28;
                const x1 = feeToX(c.minFee);
                const x2 = feeToX(c.maxFee);
                const barWidth = Math.max(x2 - x1, 8);
                const isSingle = c.minFee === c.maxFee;
                return (
                  <g class="chart-row">
                    <!-- Campus Code & Name -->
                    <text x="10" y={y + 4} font-size="11" font-weight="700" fill="var(--ink)">
                      {c.code}
                    </text>
                    <text x="42" y={y + 4} font-size="10" fill="var(--muted)">
                      {c.name.split(' ')[0]}
                    </text>

                    <!-- Background Track -->
                    <rect x="110" y={y - 4} width="330" height="8" rx="4" fill="var(--surface-alt)" stroke="var(--rule)" stroke-width="0.75" />

                    <!-- Fee Range Bar -->
                    <rect x={x1} y={y - 5} width={barWidth} height="10" rx="5" fill="var(--link)" opacity="0.85" />

                    <!-- Left & Right Markers -->
                    <circle cx={x1} cy={y} r="4" fill="var(--gold)" stroke="var(--surface)" stroke-width="1.25" />
                    {!isSingle && (
                      <circle cx={x2} cy={y} r="4" fill="var(--gold)" stroke="var(--surface)" stroke-width="1.25" />
                    )}

                    <!-- Value Label -->
                    <text x="450" y={y + 4} font-size="10.5" font-weight="600" fill="var(--ink)">
                      ₹{(c.minFee / 100000).toFixed(c.minFee % 100000 === 0 ? 0 : 2)}L{c.minFee !== c.maxFee ? `–${(c.maxFee / 100000).toFixed(c.maxFee % 100000 === 0 ? 0 : 2)}L` : ''}
                    </text>
                  </g>
                );
              })}
            </svg>
          </div>

          <details class="graphic-table-fallback">
            <summary>View text table: Fee range by campus</summary>
            <table class="graphic-data-table">
              <thead>
                <tr>
                  <th scope="col">Campus</th>
                  <th scope="col">Full Name</th>
                  <th scope="col">Min Fee / Year</th>
                  <th scope="col">Max Fee / Year</th>
                </tr>
              </thead>
              <tbody>
                {campusCards.map((c) => (
                  <tr>
                    <th scope="row"><strong>{c.code}</strong></th>
                    <td>{c.name}</td>
                    <td>₹{formatInr(c.minFee)}</td>
                    <td>₹{formatInr(c.maxFee)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>
        </div>

        <!-- Graphic 2: Options by campus -->
        <div class="data-graphic-card">
          <div class="graphic-header">
            <h3>Options by campus</h3>
            <p class="graphic-subtitle">Distribution of all 106 B.Tech programme offerings across campuses</p>
          </div>

          <div class="svg-container">
            <svg
              viewBox="0 0 550 230"
              width="100%"
              class="data-graphic-svg"
              role="img"
              aria-labelledby="options-chart-title options-chart-desc"
            >
              <title id="options-chart-title">Options by campus</title>
              <desc id="options-chart-desc">Horizontal bar chart showing the count and share of B.Tech programme offerings at each of the six SRMIST campuses.</desc>

              <!-- Gridlines & Axis labels -->
              <line x1="110" y1="20" x2="110" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="180.5" y1="20" x2="180.5" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="250.9" y1="20" x2="250.9" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="321.4" y1="20" x2="321.4" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="391.8" y1="20" x2="391.8" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />
              <line x1="420" y1="20" x2="420" y2="195" stroke="var(--rule)" stroke-width="0.75" stroke-dasharray="2 2" />

              <text x="110" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">0</text>
              <text x="180.5" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">10</text>
              <text x="250.9" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">20</text>
              <text x="321.4" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">30</text>
              <text x="391.8" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">40</text>
              <text x="440" y="210" font-size="10" font-weight="600" fill="var(--muted)" text-anchor="middle">44</text>

              <!-- Campus Options Bars -->
              {campusCards.map((c, i) => {
                const y = 32 + i * 28;
                const barWidth = countToWidth(c.optionCount);
                const percentage = ((c.optionCount / 106) * 100).toFixed(0);
                return (
                  <g class="chart-row">
                    <!-- Campus Code & Name -->
                    <text x="10" y={y + 4} font-size="11" font-weight="700" fill="var(--ink)">
                      {c.code}
                    </text>
                    <text x="42" y={y + 4} font-size="10" fill="var(--muted)">
                      {c.name.split(' ')[0]}
                    </text>

                    <!-- Background Track -->
                    <rect x="110" y={y - 5} width="310" height="10" rx="5" fill="var(--surface-alt)" stroke="var(--rule)" stroke-width="0.75" />

                    <!-- Count Bar -->
                    <rect x="110" y={y - 5} width={barWidth} height="10" rx="5" fill="var(--navy)" opacity="0.9" />

                    <!-- Value Label -->
                    <text x={110 + barWidth + 8} y={y + 4} font-size="10.5" font-weight="600" fill="var(--ink)">
                      {c.optionCount} ({percentage}%)
                    </text>
                  </g>
                );
              })}
            </svg>
          </div>

          <details class="graphic-table-fallback">
            <summary>View text table: Options by campus</summary>
            <table class="graphic-data-table">
              <thead>
                <tr>
                  <th scope="col">Campus</th>
                  <th scope="col">Full Name</th>
                  <th scope="col">B.Tech Options</th>
                  <th scope="col">Share of 106 Total</th>
                </tr>
              </thead>
              <tbody>
                {campusCards.map((c) => (
                  <tr>
                    <th scope="row"><strong>{c.code}</strong></th>
                    <td>{c.name}</td>
                    <td>{c.optionCount}</td>
                    <td>{((c.optionCount / 106) * 100).toFixed(1)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. APPLY ONCE, CHOOSE LATER STEPS -->
  <section class="blk apply-steps-section">
    <div class="w">
      <h2>Apply once, choose later</h2>
      <p class="section-subtitle">
        How the official SRM B.Tech admission process works.
      </p>

      <div class="steps-three-grid">
        <div class="home-step-card">
          <div class="home-step-badge">Step 1</div>
          <h3>Check minimum criteria</h3>
          <p>
            Confirm at least 60% aggregate across PCM/qualifying subjects and minimum age 16y 6m.
          </p>
        </div>

        <div class="home-step-card">
          <div class="home-step-badge">Step 2</div>
          <h3>Single entrance application</h3>
          <p>
            Register for SRMJEEE (B.Tech); one application covers the campuses listed on SRM's form, including these six. Branch preferences are for statistics only.
          </p>
        </div>

        <div class="home-step-card">
          <div class="home-step-badge">Step 3</div>
          <h3>Select at counselling</h3>
          <p>
            Campus, branch, and specialisation are selected at counselling after ranks are announced.
          </p>
        </div>
      </div>

      <div class="apply-steps-cta">
        <a href="/apply" class="btn s">Read complete application &amp; entrance routes guide &rarr;</a>
      </div>
    </div>
  </section>

  <!-- 6. EXAMPLE OFFERINGS (Examples you can check yourself) -->
  <section class="blk" id="programmes">
    <div class="w">
      <h2>Examples you can check yourself</h2>
      <p class="lede">
        Each row links to the exact SRM page it came from.
      </p>

      {groupedOfferings.map((group) => (
        <section class="grp">
          <h3>
            <a href={`/programmes/${programmeSlugMap.get(group.programme)}`}>
              {group.programme}
            </a>
          </h3>
          <table>
            <thead>
              <tr>
                <th scope="col">Campus</th>
                <th scope="col">Fee per year</th>
                <th scope="col">Seats</th>
                <th scope="col">Department</th>
                <th scope="col">Source check</th>
              </tr>
            </thead>
            <tbody>
              {group.items.map((offering) => {
                const feeSource = offering.annual_fee.source_id
                  ? sourcesMap[offering.annual_fee.source_id]
                  : undefined;
                const sourceUrl = feeSource ? feeSource.url : '/evidence';
                const formattedStampDate = formatDate(offering.annual_fee.captured_on) || '26 Oct 2026';

                return (
                  <tr>
                    <td data-l="Campus">{offering.campus}</td>
                    <td data-l="Fee per year" class="fee">
                      <VerifiedFact
                        fact={offering.annual_fee}
                        format="currency"
                        sourcesMap={sourcesMap}
                        showDateLink={false}
                      />
                    </td>
                    <td data-l="Seats">
                      <VerifiedFact
                        fact={offering.intake}
                        format="number"
                        sourcesMap={sourcesMap}
                        showDateLink={false}
                      />
                    </td>
                    <td data-l="Department">
                      {offering.department?.value ? offering.department.value : "Not confirmed in SRM's table"}
                    </td>
                    <td data-l="Source check">
                      <a
                        class="stamp"
                        href={sourceUrl}
                        rel="noopener"
                        target="_blank"
                      >
                        Verified {formattedStampDate}
                      </a>
                      {offering.eligibility.status === 'conflict' && (
                        <a class="flag" href="/eligibility">
                          Eligibility note
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* Hero wrapper tightening */
  .hero-grid-wrapper {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }
  .hero-main-content {
    min-width: 0;
    max-width: 100%;
  }
  @media (min-width: 860px) {
    .hero-grid-wrapper {
      grid-template-columns: 1fr auto;
      gap: 36px;
    }
  }

  .hero-seal-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    justify-self: center;
  }
  @media (min-width: 860px) {
    .hero-seal-wrapper {
      justify-self: end;
    }
  }
  .seal-meta-box {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
