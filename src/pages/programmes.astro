---
import Layout from '../layouts/Layout.astro';
import VerifiedFact, { type SourceData } from '../components/VerifiedFact.astro';
import offeringsData from '../../data/offerings.json';
import sourcesData from '../../data/sources.json';
import tagsData from '../../data/tags.json';
import synonymsData from '../../data/synonyms.json';
import programmesData from '../../data/programmes.json';
import { type OfferingItem } from '../lib/filter';

const offerings = offeringsData as OfferingItem[];
const sources = sourcesData as SourceData[];
const tagsByOffering = tagsData.by_offering as Record<string, string[]>;

const offeringSlugMap = new Map<string, string>();
for (const prog of (programmesData as { programmes: { slug: string; offering_ids: string[] }[] }).programmes) {
  for (const oid of prog.offering_ids) {
    offeringSlugMap.set(oid, prog.slug);
  }
}

// Create sources map for fast lookup
const sourcesMap = sources.reduce<Record<string, SourceData>>((acc, src) => {
  acc[src.id] = src;
  return acc;
}, {});

function formatDate(dateStr?: string): string {
  if (!dateStr) return '';
  const [year, month, day] = dateStr.split('-');
  if (year && month && day) {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const mIdx = parseInt(month, 10) - 1;
    if (mIdx >= 0 && mIdx < 12) {
      return `${parseInt(day, 10)} ${months[mIdx]} ${year}`;
    }
  }
  return dateStr;
}

// Initial default sort: Programme A-Z, then campus code
const initialOfferings = [...offerings].sort((a, b) => {
  const diff = a.programme.localeCompare(b.programme);
  if (diff !== 0) return diff;
  return a.campus_code.localeCompare(b.campus_code);
});

const campusesList = [
  { code: 'KTR', name: 'Kattankulathur' },
  { code: 'RMP', name: 'Ramapuram' },
  { code: 'Trichy', name: 'Tiruchirappalli' },
  { code: 'NCR', name: 'Delhi-NCR' },
  { code: 'VDP', name: 'Vadapalani' },
  { code: 'BAB', name: 'Baburayanpettai' }
];

const feeSteps = [
  { val: '100000', label: '₹1,00,000' },
  { val: '150000', label: '₹1,50,000' },
  { val: '200000', label: '₹2,00,000' },
  { val: '250000', label: '₹2,50,000' },
  { val: '300000', label: '₹3,00,000' },
  { val: '400000', label: '₹4,00,000' }
];
---

<Layout
  title="All 106 SRM Programmes | SRM Compass"
  description="Explore all 106 SRM B.Tech offerings with real fees, seats, departments, and eligibility notes. Filter by field, campus, and fee."
>
  <section class="blk">
    <div class="w">
      <h1>All 106 SRM Programmes</h1>
      <p class="lede">
        Search and filter across all 106 full-time B.Tech offerings at six SRMIST campuses. Every row links directly to SRM’s official Programs Offered table.
      </p>

      <!-- Filter Controls: Details element on phones, open by default -->
      <details class="mobile-filters" id="filters-details" open>
        <summary>Filters</summary>
        <div class="filters-body">
          <div class="filter-grid">
            <!-- Search box with accessible label -->
            <div class="ctrl-group">
              <label for="search-input" class="ctrl-label">Search programmes</label>
              <div class="search-input-wrap">
                <input
                  type="search"
                  id="search-input"
                  name="q"
                  placeholder="e.g. cse, artificial intelligence, kattankulathur..."
                  autocomplete="off"
                />
              </div>
            </div>

            <!-- 8 Tags Chips -->
            <div class="ctrl-group">
              <span id="chips-group-label" class="ctrl-label">Field of interest</span>
              <div class="chips-row" role="group" aria-labelledby="chips-group-label">
                {Object.entries(tagsData.labels).map(([tagKey, tagLabel]) => (
                  <button
                    type="button"
                    class="chip"
                    data-tag={tagKey}
                    aria-pressed="false"
                  >
                    {tagLabel}
                  </button>
                ))}
              </div>
            </div>

            <!-- Campuses checkboxes -->
            <div class="ctrl-group">
              <span id="campus-group-label" class="ctrl-label">Campuses</span>
              <div class="checkbox-grid" role="group" aria-labelledby="campus-group-label">
                {campusesList.map((c) => (
                  <label class="checkbox-label">
                    <input type="checkbox" name="campus" value={c.code} />
                    <span>{c.name} ({c.code})</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Fee Range & Sort Dropdowns -->
            <div class="filter-grid-3">
              <div class="ctrl-group">
                <label for="min-fee" class="ctrl-label">Minimum Fee</label>
                <select id="min-fee" name="min" class="ctrl-select">
                  <option value="">No minimum</option>
                  {feeSteps.map((s) => (
                    <option value={s.val}>{s.label}</option>
                  ))}
                </select>
              </div>

              <div class="ctrl-group">
                <label for="max-fee" class="ctrl-label">Maximum Fee</label>
                <select id="max-fee" name="max" class="ctrl-select">
                  <option value="">No maximum</option>
                  {feeSteps.map((s) => (
                    <option value={s.val}>{s.label}</option>
                  ))}
                </select>
              </div>

              <div class="ctrl-group">
                <label for="sort-order" class="ctrl-label">Sort By</label>
                <select id="sort-order" name="sort" class="ctrl-select">
                  <option value="prog-asc">Programme A–Z (default)</option>
                  <option value="fee-asc">Fee (lowest first)</option>
                  <option value="fee-desc">Fee (highest first)</option>
                  <option value="seats-desc">Seats (highest first)</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </details>

      <!-- Status Bar & Live Region -->
      <div class="status-bar">
        <div id="live-count" class="live-count" role="status" aria-live="polite">
          Showing 106 of 106 offerings
        </div>
      </div>

      <!-- Empty State with Reset Button -->
      <div id="empty-state" class="empty-state" hidden>
        <p>No programmes match your current filters.</p>
        <button type="button" id="reset-filters" class="btn p">
          Reset all filters
        </button>
      </div>

      <!-- Offerings Ledger Table (Renders all 106 in static HTML for JS-off) -->
      <table id="programmes-table" class="ledger-table">
        <thead>
          <tr>
            <th scope="col" class="th-compare">Compare</th>
            <th scope="col">Programme</th>
            <th scope="col">Campus</th>
            <th scope="col">Fee per year</th>
            <th scope="col">Seats</th>
            <th scope="col">Department</th>
            <th scope="col">Source check</th>
          </tr>
        </thead>
        <tbody id="offerings-body">
          {initialOfferings.map((offering) => {
            const feeSource = offering.annual_fee?.source_id
              ? sourcesMap[offering.annual_fee.source_id]
              : undefined;
            const sourceUrl = feeSource ? feeSource.url : '/evidence';
            const formattedDate = formatDate(offering.annual_fee?.captured_on) || '26 Oct 2026';
            const rowTags = tagsByOffering[offering.id] || [];

            return (
              <tr
                data-id={offering.id}
                data-prog={offering.programme.toLowerCase()}
                data-campus={offering.campus.toLowerCase()}
                data-campus-code={offering.campus_code.toUpperCase()}
                data-dept={(offering.department?.value ?? '').toLowerCase()}
                data-fee={offering.annual_fee?.value ?? 0}
                data-seats={offering.intake?.value ?? 0}
                data-tags={rowTags.join(' ')}
              >
                <td data-l="Compare" class="td-compare">
                  <button
                    type="button"
                    class="compare-toggle-btn"
                    data-id={offering.id}
                    aria-pressed="false"
                    aria-label={`Compare ${offering.programme} at ${offering.campus}`}
                  >
                    Compare
                  </button>
                </td>
                <td data-l="Programme">
                  <a href={`/programmes/${offeringSlugMap.get(offering.id)}`}>
                    <strong>{offering.programme}</strong>
                  </a>
                  <span class="sr-only"> ({offering.degree})</span>
                </td>
                <td data-l="Campus">
                  {offering.campus} <span class="badge-code">{offering.campus_code}</span>
                </td>
                <td data-l="Fee per year" class="fee">
                  ₹{(offering.annual_fee?.value ?? 0).toLocaleString('en-IN')}
                </td>
                <td data-l="Seats">
                  {(offering.intake?.value ?? 0).toLocaleString('en-IN')}
                </td>
                <td data-l="Department">
                  {offering.department?.value ? offering.department.value : "Not confirmed in SRM's table"}
                </td>
                <td data-l="Source check">
                  <a
                    class="stamp"
                    href={sourceUrl}
                    rel="noopener"
                    target="_blank"
                  >
                    Verified {formattedDate}
                  </a>
                  {offering.eligibility?.status === 'conflict' && (
                    <a class="flag" href="/eligibility">
                      Eligibility note
                    </a>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Sticky Compare Bar -->
  <div id="compare-sticky-bar" class="compare-sticky-bar" hidden>
    <div class="w compare-sticky-inner">
      <span id="compare-sticky-count" class="compare-sticky-text">0 selected</span>
      <div class="compare-sticky-actions">
        <a id="compare-sticky-link" href="/compare" class="btn p">Compare (0)</a>
        <button id="compare-sticky-clear" type="button" class="btn s">Clear</button>
      </div>
    </div>
  </div>

  <!-- Live region for compare selection announcements -->
  <div id="compare-announcer" class="sr-only" role="status" aria-live="polite"></div>

  <!-- Toast alert when selection exceeds 3 -->
  <div id="compare-limit-toast" class="compare-limit-toast" role="alert" hidden>
    Maximum 3 offerings can be compared at once. Remove one to add another.
  </div>

  <!-- Client-side vanilla TypeScript engine: filters, searches and sorts in place -->
  <script>
    import {
      filterOfferings,
      sortOfferings,
      matchesSearch,
      matchesWord,
      type OfferingItem
    } from '../lib/filter';
    import synonymsData from '../../data/synonyms.json';
    import tagsData from '../../data/tags.json';

    (function () {
      const table = document.getElementById('programmes-table');
      const tbody = document.getElementById('offerings-body');
      if (!table || !tbody) return;

      const rows = Array.from(tbody.querySelectorAll('tr'));
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const chipButtons = Array.from(document.querySelectorAll('.chip[data-tag]'));
      const campusCheckboxes = Array.from(document.querySelectorAll('input[name="campus"]')) as HTMLInputElement[];
      const minFeeSelect = document.getElementById('min-fee') as HTMLSelectElement | null;
      const maxFeeSelect = document.getElementById('max-fee') as HTMLSelectElement | null;
      const sortSelect = document.getElementById('sort-order') as HTMLSelectElement | null;
      const liveCount = document.getElementById('live-count');
      const emptyState = document.getElementById('empty-state');
      const resetBtn = document.getElementById('reset-filters');

      const synonyms = synonymsData || {};
      const tagsByOffering = (tagsData.by_offering || {}) as Record<string, string[]>;
      let activeTag: string | null = null;

      const rowMap = new Map<string, HTMLTableRowElement>();
      const offeringItems: OfferingItem[] = rows.map((r) => {
        const id = r.getAttribute('data-id') || '';
        rowMap.set(id, r);
        const fee = parseInt(r.getAttribute('data-fee') || '0', 10);
        const seats = parseInt(r.getAttribute('data-seats') || '0', 10);
        const deptVal = r.getAttribute('data-dept');

        return {
          id,
          programme: r.querySelector('strong')?.textContent?.trim() || '',
          campus: r.getAttribute('data-campus') || '',
          campus_code: r.getAttribute('data-campus-code') || '',
          degree: 'B.Tech',
          program_type: 'Full Time',
          annual_fee: { value: fee, status: 'verified' },
          intake: { value: seats, status: 'verified' },
          duration: { value: 4, status: 'verified' },
          department: deptVal ? { value: deptVal, status: 'verified' } : null,
          eligibility: { value: '', status: 'verified' }
        };
      });

      function syncStateToURL() {
        const params = new URLSearchParams();
        const q = searchInput ? searchInput.value.trim() : '';
        if (q) params.set('q', q);

        if (activeTag) params.set('tag', activeTag);

        const checked = campusCheckboxes.filter((cb) => cb.checked).map((cb) => cb.value);
        if (checked.length > 0) {
          params.set('campus', checked.join(','));
        }

        const min = minFeeSelect ? minFeeSelect.value : '';
        if (min) params.set('min', min);

        const max = maxFeeSelect ? maxFeeSelect.value : '';
        if (max) params.set('max', max);

        const sort = sortSelect ? sortSelect.value : 'prog-asc';
        if (sort && sort !== 'prog-asc') params.set('sort', sort);

        const qs = params.toString();
        const newUrl = qs ? window.location.pathname + '?' + qs : window.location.pathname;
        window.history.replaceState(null, '', newUrl);
      }

      function applyFiltersAndSort() {
        const q = searchInput ? searchInput.value.trim() : '';
        const checkedCampuses = campusCheckboxes
          .filter((cb) => cb.checked)
          .map((cb) => cb.value);

        const minFee = minFeeSelect && minFeeSelect.value ? parseInt(minFeeSelect.value, 10) : null;
        const maxFee = maxFeeSelect && maxFeeSelect.value ? parseInt(maxFeeSelect.value, 10) : null;
        const sortOrder = sortSelect ? sortSelect.value : 'prog-asc';

        // Filter offerings using single imported function from src/lib/filter.ts
        const filtered = filterOfferings(offeringItems, {
          q,
          tag: activeTag,
          campuses: checkedCampuses,
          minFee,
          maxFee,
          tagsByOffering,
          synonyms
        });

        // Sort offerings using single imported function from src/lib/filter.ts
        const sorted = sortOfferings(filtered, sortOrder);

        const visibleIds = new Set(sorted.map((o) => o.id));

        // Update DOM visibility
        rows.forEach((row) => {
          const id = row.getAttribute('data-id') || '';
          row.hidden = !visibleIds.has(id);
        });

        // Re-append visible rows in sorted order
        const frag = document.createDocumentFragment();
        sorted.forEach((o) => {
          const rowEl = rowMap.get(o.id);
          if (rowEl) frag.appendChild(rowEl);
        });
        tbody.appendChild(frag);

        if (liveCount) {
          liveCount.textContent = `${sorted.length} of ${rows.length} offerings`;
        }

        if (sorted.length === 0) {
          table.hidden = true;
          if (emptyState) emptyState.hidden = false;
        } else {
          table.hidden = false;
          if (emptyState) emptyState.hidden = true;
        }

        syncStateToURL();
      }

      function loadStateFromURL() {
        const params = new URLSearchParams(window.location.search);
        const q = params.get('q');
        if (q && searchInput) searchInput.value = q;

        const tag = params.get('tag');
        if (tag) {
          activeTag = tag;
          chipButtons.forEach((btn) => {
            btn.setAttribute('aria-pressed', btn.getAttribute('data-tag') === tag ? 'true' : 'false');
          });
        }

        const campusParam = params.get('campus');
        if (campusParam) {
          const selected = new Set(campusParam.split(',').map((c) => c.trim().toUpperCase()));
          campusCheckboxes.forEach((cb) => {
            cb.checked = selected.has(cb.value.toUpperCase());
          });
        }

        const min = params.get('min');
        if (min && minFeeSelect) minFeeSelect.value = min;

        const max = params.get('max');
        if (max && maxFeeSelect) maxFeeSelect.value = max;

        const sort = params.get('sort');
        if (sort && sortSelect) sortSelect.value = sort;
      }

      // Event Listeners
      if (searchInput) {
        searchInput.addEventListener('input', applyFiltersAndSort);
      }

      chipButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tag = btn.getAttribute('data-tag');
          if (activeTag === tag) {
            activeTag = null;
            btn.setAttribute('aria-pressed', 'false');
          } else {
            activeTag = tag;
            chipButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
            btn.setAttribute('aria-pressed', 'true');
          }
          applyFiltersAndSort();
        });
      });

      campusCheckboxes.forEach((cb) => {
        cb.addEventListener('change', applyFiltersAndSort);
      });

      if (minFeeSelect) minFeeSelect.addEventListener('change', applyFiltersAndSort);
      if (maxFeeSelect) maxFeeSelect.addEventListener('change', applyFiltersAndSort);
      if (sortSelect) sortSelect.addEventListener('change', applyFiltersAndSort);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          activeTag = null;
          chipButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
          campusCheckboxes.forEach((cb) => (cb.checked = false));
          if (minFeeSelect) minFeeSelect.value = '';
          if (maxFeeSelect) maxFeeSelect.value = '';
          if (sortSelect) sortSelect.value = 'prog-asc';
          applyFiltersAndSort();
        });
      }

      // Compare selection logic
      const selectedCompareIds = new Set<string>();
      const stickyBar = document.getElementById('compare-sticky-bar');
      const stickyLink = document.getElementById('compare-sticky-link') as HTMLAnchorElement | null;
      const stickyCount = document.getElementById('compare-sticky-count');
      const stickyClear = document.getElementById('compare-sticky-clear');
      const compareAnnouncer = document.getElementById('compare-announcer');
      const compareLimitToast = document.getElementById('compare-limit-toast');
      let toastTimer: any = null;

      function showToast(msg: string) {
        if (!compareLimitToast) return;
        compareLimitToast.textContent = msg;
        compareLimitToast.hidden = false;
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          if (compareLimitToast) compareLimitToast.hidden = true;
        }, 3500);
      }

      function updateCompareStickyUI() {
        const count = selectedCompareIds.size;
        if (!stickyBar || !stickyLink || !stickyCount) return;

        if (count > 0) {
          stickyBar.hidden = false;
          stickyLink.href = `/compare?ids=${Array.from(selectedCompareIds).join(',')}`;
          stickyLink.textContent = `Compare (${count})`;
          stickyCount.textContent = `${count} selected (max 3)`;
        } else {
          stickyBar.hidden = true;
        }
      }

      // Delegate click on compare toggle buttons
      tbody.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest<HTMLButtonElement>('.compare-toggle-btn');
        if (!btn) return;

        const id = btn.getAttribute('data-id');
        if (!id) return;

        const isPressed = btn.getAttribute('aria-pressed') === 'true';

        if (isPressed) {
          selectedCompareIds.delete(id);
          btn.setAttribute('aria-pressed', 'false');
          btn.classList.remove('is-selected');
          btn.textContent = 'Compare';
          if (compareAnnouncer) {
            compareAnnouncer.textContent = `Removed offering from comparison. ${selectedCompareIds.size} of 3 selected.`;
          }
        } else {
          if (selectedCompareIds.size >= 3) {
            const msg = 'Maximum 3 offerings can be compared at once. Remove one to add another.';
            if (compareAnnouncer) compareAnnouncer.textContent = msg;
            showToast(msg);
            return;
          }
          selectedCompareIds.add(id);
          btn.setAttribute('aria-pressed', 'true');
          btn.classList.add('is-selected');
          btn.textContent = 'Selected';
          if (compareAnnouncer) {
            compareAnnouncer.textContent = `Added offering to comparison. ${selectedCompareIds.size} of 3 selected.`;
          }
        }

        updateCompareStickyUI();
      });

      if (stickyClear) {
        stickyClear.addEventListener('click', () => {
          selectedCompareIds.clear();
          const allToggleBtns = tbody.querySelectorAll<HTMLButtonElement>('.compare-toggle-btn');
          allToggleBtns.forEach((btn) => {
            btn.setAttribute('aria-pressed', 'false');
            btn.classList.remove('is-selected');
            btn.textContent = 'Compare';
          });
          updateCompareStickyUI();
          if (compareAnnouncer) {
            compareAnnouncer.textContent = 'Cleared all compare selections.';
          }
        });
      }

      // Keep reference to imported utilities to ensure they are bundled and available
      if (false as boolean) {
        matchesWord('', '');
        matchesSearch(offeringItems[0], '');
      }

      // Initialize state from URL on page load
      loadStateFromURL();
      applyFiltersAndSort();
    })();
  </script>
</Layout>

<style>
  .th-compare,
  .td-compare {
    width: 90px;
    text-align: center;
  }

  .compare-toggle-btn {
    display: inline-block;
    padding: 4px 10px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .compare-toggle-btn:hover {
    border-color: var(--link);
    color: var(--link);
  }

  .compare-toggle-btn.is-selected {
    background: var(--ink);
    border-color: var(--ink);
    color: #ffffff;
  }

  .compare-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--surface);
    border-top: 2px solid var(--gold);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
    z-index: 100;
    padding: 12px 0;
  }

  .compare-sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .compare-sticky-text {
    font-weight: 600;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .compare-sticky-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .compare-limit-toast {
    position: fixed;
    bottom: 75px;
    left: 50%;
    transform: translateX(-50%);
    background: #FFF8E6;
    color: #5C3800;
    border: 1px solid var(--gold);
    padding: 10px 18px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    z-index: 101;
    max-width: 90vw;
    text-align: center;
  }

  @media (max-width: 768px) {
    .th-compare,
    .td-compare {
      width: auto;
      text-align: left;
    }
  }
</style>
