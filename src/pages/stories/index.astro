---
import Layout from '../../layouts/Layout.astro';
import { getAllStories } from '../../lib/stories';

const stories = getAllStories();
---

<Layout
  title="Built at SRM: Student and Alumni Stories — SRM Compass"
  description="Verified and sourced stories of student teams, startups, and projects built by SRM alumni and students. Every claim cited to its primary document."
>
  <div class="w page-container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">&rsaquo;</span>
      <span aria-current="page">Stories</span>
    </nav>

    <header class="stories-header">
      <div class="eyebrow">Evidence-backed student achievements</div>
      <h1>Built at SRM</h1>
      <p class="lead">
        Student teams, engineering ventures, and start-ups founded by SRM students and alumni. Every fact is cited to an official SRM document or published report with capture dates and source tiers.
      </p>
      <div class="sourced-policy-note">
        <strong>Source tier note:</strong> Facts labeled <em>Sourced</em> come from SRM’s official 2026-27 admission brochure or published reports. They represent SRM’s self-reported figures rather than independently audited metrics.
      </div>
    </header>

    <div class="stories-list-grid">
      {stories.map((story) => (
        <article class="story-list-card">
          <div class="story-card-top">
            <span class="story-badge">{story.kind}</span>
            <span class="fact-count-pill">{story.facts.length} documented facts</span>
          </div>
          
          <h2 class="story-card-title">
            <a href={`/stories/${story.id}`}>{story.title}</a>
          </h2>
          
          <p class="story-card-basis">{story.link_basis}</p>

          <div class="story-card-preview">
            <p class="preview-fact">
              &ldquo;{story.facts[0]?.text}&rdquo;
            </p>
          </div>

          <div class="story-card-programmes">
            {story.programmes.length > 0 ? (
              <div class="prog-tags-list">
                <span class="prog-tags-label">Related:</span>
                {story.programmes.map((p) => (
                  <a href={`/programmes/${p.slug}`} class="tag-prog">
                    {p.name}
                  </a>
                ))}
              </div>
            ) : (
              <span class="tag-unlinked">Not tied to a B.Tech programme</span>
            )}
          </div>

          <div class="story-card-footer">
            <a href={`/stories/${story.id}`} class="btn-read-story">
              Read story &amp; source evidence &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: 28px;
    padding-bottom: 60px;
  }
  .breadcrumb {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breadcrumb a {
    color: var(--link);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .stories-header {
    margin-bottom: 36px;
  }
  .eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--navy);
    margin-bottom: 8px;
  }
  .stories-header h1 {
    font-size: 2.3rem;
    line-height: 1.2;
    margin: 0 0 14px 0;
    color: var(--navy);
    font-family: Charter, "Iowan Old Style", Georgia, serif;
    font-weight: 700;
  }
  .lead {
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 75ch;
    margin-bottom: 16px;
  }
  .sourced-policy-note {
    background: var(--surface);
    border-left: 4px solid var(--accent);
    padding: 12px 16px;
    font-size: 0.9rem;
    line-height: 1.5;
    border-radius: 0 6px 6px 0;
    color: var(--text);
    max-width: 75ch;
  }
  .stories-list-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }
  .story-list-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .story-list-card:hover {
    box-shadow: 0 4px 14px rgba(0,0,0,0.06);
  }
  .story-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .story-badge {
    background: var(--surface-alt);
    color: var(--navy);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--rule);
  }
  .fact-count-pill {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .story-card-title {
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 0 0 10px 0;
    font-family: Charter, "Iowan Old Style", Georgia, serif;
  }
  .story-card-title a {
    color: var(--navy);
    text-decoration: none;
  }
  .story-card-title a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .story-card-basis {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text-muted);
    margin-bottom: 14px;
  }
  .story-card-preview {
    background: var(--surface-alt);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 16px;
    flex-grow: 1;
  }
  .preview-fact {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    font-style: italic;
    color: var(--text);
  }
  .story-card-programmes {
    margin-bottom: 16px;
    min-height: 28px;
  }
  .prog-tags-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
  }
  .prog-tags-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .tag-prog {
    background: var(--surface);
    color: var(--link);
    padding: 3px 8px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.8rem;
  }
  .tag-prog:hover {
    text-decoration: underline;
  }
  .tag-unlinked {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--surface-alt);
    border: 1px dashed var(--rule);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .story-card-footer {
    border-top: 1px solid var(--rule);
    padding-top: 14px;
  }
  .btn-read-story {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--link);
    text-decoration: none;
  }
  .btn-read-story:hover {
    text-decoration: underline;
  }
</style>
